    "!pip install -q python-pptx\n",
    "\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "print(\"✅ Dépendances installées\")\n",
    "print(\"✅ Google Drive monté\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "config"
   },
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "# Configuration Google Drive\n",
    "DRIVE_FOLDER = \"/content/drive/MyDrive/PF_SCORING\"  # À adapter à votre chemin\n",
    "\n",
    "# Lister les fichiers disponibles\n",
    "print(\"📁 Fichiers dans votre dossier Google Drive:\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "if os.path.exists(DRIVE_FOLDER):\n",
    "    files = os.listdir(DRIVE_FOLDER)\n",
    "    csv_files = [f for f in files if f.endswith('.csv')]\n",
    "    \n",
    "    print(f\"\\n📂 Chemin: {DRIVE_FOLDER}\")\n",
    "    print(f\"\\n📄 Fichiers CSV trouvés:\")\n",
    "    for i, csv_file in enumerate(csv_files, 1):\n",
    "        print(f\"   {i}. {csv_file}\")\n",
    "    \n",
    "    if csv_files:\n",
    "        CSV_FILE = os.path.join(DRIVE_FOLDER, csv_files[0])\n",
    "        print(f\"\\n✅ Fichier sélectionné: {csv_files[0]}\")\n",
    "    else:\n",
    "        print(\"\\n❌ Aucun fichier CSV trouvé!\")\n",
    "        print(\"💡 Assurez-vous que le chemin DRIVE_FOLDER est correct\")\nelse:\n",
    "    print(f\"\\n❌ Le dossier {DRIVE_FOLDER} n'existe pas\")\n",
    "    print(\"\\n💡 Modifiez DRIVE_FOLDER avec votre chemin:\")\n",
    "    print(\"   /content/drive/MyDrive/MonfDossier\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "generator_code"
   },
   "outputs": [],
   "source": [
    "import csv\n",
    "from pptx import Presentation\n",
    "from pptx.util import Inches, Pt\n",
    "from pptx.enum.text import PP_ALIGN\n",
    "from pptx.dml.color import RGBColor\n",
    "from pptx.chart.data import CategoryChartData\n",
    "from pptx.enum.chart import XL_CHART_TYPE\n",
    "\n",
    "# Couleurs thème bancaire\n",
    "PRIMARY_BLUE = RGBColor(0, 51, 102)\n",
    "ACCENT_ORANGE = RGBColor(255, 153, 0)\n",
    "LIGHT_GRAY = RGBColor(240, 240, 240)\n",
    "WHITE = RGBColor(255, 255, 255)\n",
    "GREEN = RGBColor(76, 175, 80)\n",
    "ORANGE = RGBColor(255, 152, 0)\n",
    "RED = RGBColor(244, 67, 54)\n",
    "DARK_TEXT = RGBColor(33, 33, 33)\n",
    "\n",
    "\n",
    "def parse_completion(item):\n",
    "    try:\n",
    "        comp_str = item.get(\"COMPLÉTION_%\", \"0\").rstrip(\"%\").strip()\n",
    "        return float(comp_str) if comp_str else 0\n",
    "    except:\n",
    "        return 0\n",
    "\n",
    "\n",
    "def load_csv_data(csv_file):\n",
    "    print(f\"📥 Chargement: {os.path.basename(csv_file)}...\")\n",
    "    items = []\n",
    "    with open(csv_file, \"r\", encoding=\"utf-8\") as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        items = list(reader)\n",
    "    print(f\"✅ {len(items)} éléments chargés\")\n",
    "    return items\n",
    "\n",
    "\n",
    "def calculate_statistics(items):\n",
    "    print(\"📊 Calcul des statistiques...\")\n",
    "    completions = [parse_completion(item) for item in items]\n",
    "\n",
    "    stats = {\n",
    "        \"total\": len(items),\n",
    "        \"integrated\": len([i for i in items if i.get(\"STATUT\") == \"INTÉGRÉ\"]),\n",
    "        \"in_progress\": len([i for i in items if i.get(\"STATUT\") == \"EN COURS\"]),\n",
    "        \"planned\": len([i for i in items if i.get(\"STATUT\") == \"PLANIFIÉ\"]),\n",
    "        \"blocked\": len([i for i in items if i.get(\"STATUT\") == \"BLOQUÉ\"]),\n",
    "        \"by_bloc\": {},\n",
    "        \"risks\": [i for i in items if i.get(\"STATUT\") == \"BLOQUÉ\" or parse_completion(i) < 50],\n",
    "    }\n",
    "\n",
    "    stats[\"average_completion\"] = sum(completions) / len(completions) if completions else 0\n",
    "\n",
    "    for item in items:\n",
    "        bloc = item.get(\"BLOC\", \"Unknown\")\n",
    "        if bloc not in stats[\"by_bloc\"]:\n",
    "            stats[\"by_bloc\"][bloc] = {\"total\": 0, \"completion_sum\": 0}\n",
    "        stats[\"by_bloc\"][bloc][\"total\"] += 1\n",
    "        stats[\"by_bloc\"][bloc][\"completion_sum\"] += parse_completion(item)\n",
    "\n",
    "    for bloc in stats[\"by_bloc\"]:\n",
    "        items_count = stats[\"by_bloc\"][bloc][\"total\"]\n",
    "        stats[\"by_bloc\"][bloc][\"completion\"] = (\n",
    "            stats[\"by_bloc\"][bloc][\"completion_sum\"] / items_count if items_count > 0 else 0\n",
    "        )\n",
    "\n",
    "    print(f\"✅ Stats: {stats['total']} items | {stats['average_completion']:.1f}% complet\")\n",
    "    return stats\n",
    "\n",
    "\n",
    "def add_title_slide(prs, stats):\n",
    "    slide = prs.slides.add_slide(prs.slide_layouts[6])\n",
    "    background = slide.background\n",
    "    fill = background.fill\n",
    "    fill.solid()\n",
    "    fill.fore_color.rgb = PRIMARY_BLUE\n",
    "\n",
    "    title_box = slide.shapes.add_textbox(Inches(0.5), Inches(2.5), Inches(9), Inches(1.5))\n",
    "    p = title_box.text_frame.paragraphs[0]\n",
    "    p.text = \"PF SCORING\"\n",
    "    p.font.size = Pt(66)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = WHITE\n",
    "    p.alignment = PP_ALIGN.CENTER\n",
    "\n",
    "    subtitle_box = slide.shapes.add_textbox(Inches(0.5), Inches(4.2), Inches(9), Inches(1))\n",
    "    p = subtitle_box.text_frame.paragraphs[0]\n",
    "    p.text = \"COMITÉ DE PILOTAGE - COPIL\"\n",
    "    p.font.size = Pt(32)\n",
    "    p.font.color.rgb = ACCENT_ORANGE\n",
    "    p.alignment = PP_ALIGN.CENTER\n",
    "\n",
    "    date_box = slide.shapes.add_textbox(Inches(0.5), Inches(6.5), Inches(9), Inches(0.5))\n",
    "    p = date_box.text_frame.paragraphs[0]\n",
    "    p.text = f\"Statut Global: {stats['average_completion']:.0f}% Complété\"\n",
    "    p.font.size = Pt(18)\n",
    "    p.font.color.rgb = LIGHT_GRAY\n",
    "    p.alignment = PP_ALIGN.CENTER\n",
    "\n",
    "\n",
    "def add_kpi_slide(prs, stats):\n",
    "    slide = prs.slides.add_slide(prs.slide_layouts[6])\n",
    "    background = slide.background.fill\n",
    "    background.solid()\n",
    "    background.fore_color.rgb = WHITE\n",
    "\n",
    "    title_box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), Inches(9), Inches(0.5))\n",
    "    p = title_box.text_frame.paragraphs[0]\n",
    "    p.text = \"RÉSUMÉ EXÉCUTIF - KPIs\"\n",
    "    p.font.size = Pt(40)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = PRIMARY_BLUE\n",
    "\n",
    "    kpis = [\n",
    "        (\"INTÉGRÉ\", stats[\"integrated\"], GREEN),\n",
    "        (\"EN COURS\", stats[\"in_progress\"], ORANGE),\n",
    "        (\"PLANIFIÉ\", stats[\"planned\"], RGBColor(33, 150, 243)),\n",
    "        (\"BLOQUÉ\", stats[\"blocked\"], RED),\n",
    "    ]\n",
    "\n",
    "    start_x, start_y = 0.8, 1.3\n",
    "    for idx, (label, count, color) in enumerate(kpis):\n",
    "        x = start_x + (idx * 2.1)\n",
    "        shape = slide.shapes.add_shape(1, Inches(x), Inches(start_y), Inches(1.8), Inches(1.5))\n",
    "        shape.fill.solid()\n",
    "        shape.fill.fore_color.rgb = color\n",
    "        shape.line.color.rgb = color\n",
    "\n",
    "        count_box = slide.shapes.add_textbox(Inches(x), Inches(start_y + 0.2), Inches(1.8), Inches(0.7))\n",
    "        p = count_box.text_frame.paragraphs[0]\n",
    "        p.text = str(count)\n",
    "        p.font.size = Pt(48)\n",
    "        p.font.bold = True\n",
    "        p.font.color.rgb = WHITE\n",
    "        p.alignment = PP_ALIGN.CENTER\n",
    "\n",
    "        label_box = slide.shapes.add_textbox(Inches(x), Inches(start_y + 0.9), Inches(1.8), Inches(0.4))\n",
    "        p = label_box.text_frame.paragraphs[0]\n",
    "        p.text = label\n",
    "        p.font.size = Pt(14)\n",
    "        p.font.color.rgb = WHITE\n",
    "        p.alignment = PP_ALIGN.CENTER\n",
    "\n",
    "\n",
    "def add_completion_chart_slide(prs, stats):\n",
    "    slide = prs.slides.add_slide(prs.slide_layouts[6])\n",
    "    background = slide.background.fill\n",
    "    background.solid()\n",
    "    background.fore_color.rgb = WHITE\n",
    "\n",
    "    title_box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), Inches(9), Inches(0.5))\n",
    "    p = title_box.text_frame.paragraphs[0]\n",
    "    p.text = \"AVANCEMENT PAR BLOC\"\n",
    "    p.font.size = Pt(40)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = PRIMARY_BLUE\n",
    "\n",
    "    chart = slide.shapes.add_chart(\n",
    "        XL_CHART_TYPE.COLUMN_CLUSTERED, Inches(0.5), Inches(1.1), Inches(9), Inches(5.2)\n",
    "    ).chart\n",
    "\n",
    "    chart.has_legend = False\n",
    "    chart_data = chart.chart_data\n",
    "    chart_data.categories = list(stats[\"by_bloc\"].keys())\n",
    "    completions = [stats[\"by_bloc\"][bloc][\"completion\"] for bloc in stats[\"by_bloc\"]]\n",
    "    chart_data.add_series(\"Complétude %\", tuple(completions))\n",
    "\n",
    "    series = chart.plots[0].series[0]\n",
    "    for idx, completion in enumerate(completions):\n",
    "        color = GREEN if completion >= 90 else ORANGE if completion >= 70 else RED\n",
    "        series.points[idx].format.fill.solid()\n",
    "        series.points[idx].format.fill.fore_color.rgb = color\n",
    "\n",
    "\n",
    "def add_gauge_slide(prs, stats):\n",
    "    slide = prs.slides.add_slide(prs.slide_layouts[6])\n",
    "    background = slide.background.fill\n",
    "    background.solid()\n",
    "    background.fore_color.rgb = WHITE\n",
    "\n",
    "    title_box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), Inches(9), Inches(0.5))\n",
    "    p = title_box.text_frame.paragraphs[0]\n",
    "    p.text = \"COMPLÉTUDE GLOBALE\"\n",
    "    p.font.size = Pt(40)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = PRIMARY_BLUE\n",
    "\n",
    "    completion = stats[\"average_completion\"]\n",
    "    percent_box = slide.shapes.add_textbox(Inches(3), Inches(2), Inches(4), Inches(2))\n",
    "    p = percent_box.text_frame.paragraphs[0]\n",
    "    p.text = f\"{completion:.0f}%\"\n",
    "    p.font.size = Pt(120)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = GREEN if completion >= 80 else ORANGE if completion >= 50 else RED\n",
    "    p.alignment = PP_ALIGN.CENTER\n",
    "\n",
    "    bar_bg = slide.shapes.add_shape(1, Inches(1.5), Inches(4.8), Inches(7), Inches(0.5))\n",
    "    bar_bg.fill.solid()\n",
    "    bar_bg.fill.fore_color.rgb = LIGHT_GRAY\n",
    "\n",
    "    bar_fg = slide.shapes.add_shape(1, Inches(1.5), Inches(4.8), Inches(7 * (completion / 100)), Inches(0.5))\n",
    "    bar_fg.fill.solid()\n",
    "    bar_fg.fill.fore_color.rgb = GREEN if completion >= 80 else ORANGE if completion >= 50 else RED\n",
    "\n",
    "\n",
    "def add_risks_slide(prs, stats):\n",
    "    slide = prs.slides.add_slide(prs.slide_layouts[6])\n",
    "    background = slide.background.fill\n",
    "    background.solid()\n",
    "    background.fore_color.rgb = WHITE\n",
    "\n",
    "    title_box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), Inches(9), Inches(0.5))\n",
    "    p = title_box.text_frame.paragraphs[0]\n",
    "    p.text = \"RISQUES & BLOCAGES\"\n",
    "    p.font.size = Pt(40)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = PRIMARY_BLUE\n",
    "\n",
    "    risks = stats[\"risks\"][:5]\n",
    "    if not risks:\n",
    "        no_risks_box = slide.shapes.add_textbox(Inches(0.5), Inches(2), Inches(9), Inches(4))\n",
    "        p = no_risks_box.text_frame.paragraphs[0]\n",
    "        p.text = \"✅ Aucun risque identifié\"\n",
    "        p.font.size = Pt(28)\n",
    "        p.font.color.rgb = GREEN\n",
    "        p.alignment = PP_ALIGN.CENTER\n",
    "    else:\n",
    "        y = 1.3\n",
    "        for risk in risks:\n",
    "            risk_box = slide.shapes.add_textbox(Inches(0.7), Inches(y), Inches(8.6), Inches(0.8))\n",
    "            p = risk_box.text_frame.paragraphs[0]\n",
    "            p.text = f\"🔴 {risk.get('ÉLÉMENT')} ({risk.get('STATUT')} - {parse_completion(risk):.0f}%)\"\n",
    "            p.font.size = Pt(14)\n",
    "            p.font.color.rgb = RED\n",
    "            y += 0.9\n",
    "\n",
    "\n",
    "def add_next_steps_slide(prs, stats):\n",
    "    slide = prs.slides.add_slide(prs.slide_layouts[6])\n",
    "    background = slide.background.fill\n",
    "    background.solid()\n",
    "    background.fore_color.rgb = WHITE\n",
    "\n",
    "    title_box = slide.shapes.add_textbox(Inches(0.5), Inches(0.3), Inches(9), Inches(0.5))\n",
    "    p = title_box.text_frame.paragraphs[0]\n",
    "    p.text = \"PROCHAINES ÉTAPES\"\n",
    "    p.font.size = Pt(40)\n",
    "    p.font.bold = True\n",
    "    p.font.color.rgb = PRIMARY_BLUE\n",
    "\n",
    "    phases = [\n",
    "        (\"Phase 9\", \"Design Responsive Mobile\"),\n",
    "        (\"Phase 10\", \"Tests & QA Complète\"),\n",
    "        (\"Phase 11\", \"Déploiement Production\"),\n",
    "        (\"Phase 12\", \"Monitoring & Support\"),\n",
    "    ]\n",
    "\n",
    "    y = 1.3\n",
    "    for phase, description in phases:\n",
    "        phase_shape = slide.shapes.add_shape(1, Inches(0.7), Inches(y), Inches(0.6), Inches(0.6))\n",
    "        phase_shape.fill.solid()\n",
    "        phase_shape.fill.fore_color.rgb = ACCENT_ORANGE\n",
    "\n",
    "        desc_box = slide.shapes.add_textbox(Inches(1.5), Inches(y + 0.05), Inches(7.8), Inches(0.5))\n",
    "        p = desc_box.text_frame.paragraphs[0]\n",
    "        p.text = f\"{phase} - {description}\"\n",
    "        p.font.size = Pt(16)\n",
    "        p.font.color.rgb = DARK_TEXT\n",
    "\n",
    "        y += 1\n",
    "\n",
    "\n",
    "def create_presentation(stats, output_file):\n",
    "    print(\"\\n📝 Création de la présentation...\")\n",
    "    prs = Presentation()\n",
    "    prs.slide_width = Inches(10)\n",
    "    prs.slide_height = Inches(7.5)\n",
    "\n",
    "    add_title_slide(prs, stats)\n",
    "    add_kpi_slide(prs, stats)\n",
    "    add_completion_chart_slide(prs, stats)\n",
    "    add_gauge_slide(prs, stats)\n",
    "    add_risks_slide(prs, stats)\n",
    "    add_next_steps_slide(prs, stats)\n",
    "\n",
    "    prs.save(output_file)\n",
    "    print(f\"✅ Présentation créée: {os.path.basename(output_file)}\")\n",
    "    print(f\"📊 6 slides générées\")\n",
    "\n",
    "\n",
    "print(\"✅ Fonctions prêtes\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "generate_ppt"
   },
   "outputs": [],
   "source": [
    "# GÉNÉRER LA PRÉSENTATION\n",
    "print(\"\\n🚀 PF Scoring - Générateur COPIL (Google Drive)\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "if os.path.exists(CSV_FILE):\n",
    "    # Charger et traiter\n",
    "    items = load_csv_data(CSV_FILE)\n",
    "    stats = calculate_statistics(items)\n",
    "    \n",
    "    # Créer le PPT dans le même dossier\n",
    "    output_file = os.path.join(DRIVE_FOLDER, \"COPIL_Presentation.pptx\")\n",
    "    create_presentation(stats, output_file)\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(f\"✅ Fichier généré dans Google Drive!\")\n",
    "    print(f\"📍 Chemin: {output_file}\")\n",
    "    print(f\"📥 Vérifiez votre dossier Drive\")\n",
    "    print(\"=\" * 60)\n",
    "else:\n",
    "    print(f\"❌ Fichier non trouvé: {CSV_FILE}\")"
   ]
  }
