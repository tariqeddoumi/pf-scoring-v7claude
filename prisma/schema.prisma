generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nom       String
  prenom    String
  role      UserRole @default(analyste)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectsCreated Project[]
  auditLogs       AuditLog[]

  @@map("pf_scoring_users")
}

model Project {
  id            String        @id @default(uuid())
  nom           String
  description   String
  secteur       String
  montant       Float
  devise        String        @default("MAD")
  status        ProjectStatus @default(brouillon)
  scoreGlobal   Float?
  grade         String?
  creePar       String        @db.Uuid
  dateCreation  DateTime      @default(now())
  dateMiseAJour DateTime      @updatedAt

  user      User       @relation(fields: [creePar], references: [id], onDelete: Cascade)
  scorings  Scoring[]
  auditLogs AuditLog[]

  @@index([creePar])
  @@map("pf_scoring_projects")
}

model Scoring {
  id          String   @id @default(uuid())
  projectId   String
  scoreGlobal Float
  grade       String
  composantes Json
  version     Int
  dateCalcul  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("pf_scoring_scorings")
}

model AuditLog {
  id            String   @id @default(uuid())
  projectId     String?
  utilisateurId String
  action        String
  details       String
  timestamp     DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([utilisateurId])
  @@index([timestamp])
  @@map("pf_scoring_audit_logs")
}

enum ProjectStatus {
  brouillon
  en_cours
  en_revue
  approuve
  rejete
}

enum UserRole {
  admin
  manager
  analyste
  lecteur
}
