generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nom       String
  prenom    String
  role      UserRole @default(analyste)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectsCreated Project[]
  auditLogs       AuditLog[]

  @@map("pf_scoring_users")
}

model Project {
  id            String        @id @default(uuid())
  nom           String
  description   String
  secteur       String
  montant       Float
  devise        String        @default("MAD")
  status        ProjectStatus @default(brouillon)
  scoreGlobal   Float?
  grade         String?
  creePar       String        @db.Uuid
  countryCode   String?
  dateCreation  DateTime      @default(now())
  dateMiseAJour DateTime      @updatedAt

  user      User       @relation(fields: [creePar], references: [id], onDelete: Cascade)
  scorings  Scoring[]
  auditLogs AuditLog[]

  @@index([creePar])
  @@map("pf_scoring_projects")
}

model Scoring {
  id          String   @id @default(uuid())
  projectId   String
  scoreGlobal Float
  grade       String
  composantes Json
  version     Int
  dateCalcul  DateTime @default(now())

  project               Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluationDomainScores EvaluationDomainScore[]
  evaluationAnswers     EvaluationAnswer[]

  @@map("pf_scoring_scorings")
}

model AuditLog {
  id            String   @id @default(uuid())
  projectId     String?
  utilisateurId String
  action        String
  details       String
  timestamp     DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([utilisateurId])
  @@index([timestamp])
  @@map("pf_scoring_audit_logs")
}

model ScoreDomain {
  id              String          @id @default(uuid())
  code            String          @unique
  label           String
  description     String?
  isActive        Boolean         @default(true)
  weight          Float           @default(0.125)
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  criteria        ScoreCriterion[]
  evaluationDomainScores EvaluationDomainScore[]

  @@map("pf_scoring_domains")
}

model ScoreCriterion {
  id              String          @id @default(uuid())
  domainId        String
  code            String
  label           String
  description     String?
  type            String          @default("OPTION")
  isActive        Boolean         @default(true)
  hardStopIfBelow Float?
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  domain          ScoreDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  options         ScoreOption[]
  ranges          ScoreRange[]
  evaluationAnswers EvaluationAnswer[]

  @@unique([domainId, code])
  @@index([domainId])
  @@map("pf_scoring_criteria")
}

model ScoreOption {
  id              String          @id @default(uuid())
  criterionId     String
  label           String
  score           Float
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  criterion       ScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("pf_scoring_options")
}

model ScoreRange {
  id              String          @id @default(uuid())
  criterionId     String
  minValue        Float
  maxValue        Float
  score           Float
  label           String?
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  criterion       ScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("pf_scoring_ranges")
}

model Country {
  id              String          @id @default(uuid())
  code            String          @unique
  label           String
  riskScore       Float           @default(50.0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("pf_scoring_countries")
}

model SystemConfig {
  id              String          @id @default(uuid())
  key             String          @unique
  value           String
  description     String?
  updatedAt       DateTime        @updatedAt

  @@map("pf_scoring_system_config")
}

model EvaluationDomainScore {
  id              String          @id @default(uuid())
  domainId        String
  scoringId       String
  score           Float
  weight          Float
  createdAt       DateTime        @default(now())

  domain          ScoreDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scoring         Scoring         @relation(fields: [scoringId], references: [id], onDelete: Cascade)

  @@unique([domainId, scoringId])
  @@index([domainId])
  @@index([scoringId])
  @@map("pf_scoring_evaluation_domain_scores")
}

model EvaluationAnswer {
  id              String          @id @default(uuid())
  criterionId     String
  scoringId       String
  answerType      String          @default("OPTION")
  optionValue     String?
  rangeValue      Float?
  score           Float?
  createdAt       DateTime        @default(now())

  criterion       ScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  scoring         Scoring         @relation(fields: [scoringId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@index([scoringId])
  @@map("pf_scoring_evaluation_answers")
}

enum ProjectStatus {
  brouillon
  en_cours
  en_revue
  approuve
  rejete
}

enum UserRole {
  admin
  manager
  analyste
  lecteur
}
