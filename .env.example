# ==========================================
# BASE DE DONNÉES (tout PostgreSQL 14+ : Supabase, hébergé par la banque, RDS, Azure…)
# Changer de base : docs/changer-de-base.md (npm run db:schema / db:copier / db:verifier)
# ==========================================
# Exemple Supabase (pooler) ; pour un PostgreSQL classique :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/pfscoring?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_...
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_...

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
# Signature HMAC des webhooks entrants (en-têtes x-webhook-signature / -timestamp / -id)
WEBHOOK_SECRET=change-me-random-32-chars-min
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-change-in-production
NODE_ENV=development

# ==========================================
# APPLICATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# DEPLOYMENT
# ==========================================
VERCEL_ENV=preview

# ==========================================
# OPTIONAL: Email Service
# ==========================================
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-email
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@yourapp.com

# ==========================================
# OPTIONAL: Logging & Monitoring
# ==========================================
# LOG_LEVEL=info
# SENTRY_DSN=https://...@sentry.io/...

# ==========================================
# OPTIONAL: Integration Tokens
# ==========================================
# NOTION_API_KEY=your-notion-api-key
# INIT_TOKEN=your-init-secret-token

# ==========================================
# ANALYSE DES PIÈCES PAR IA
# ==========================================
# Clé de l'API Anthropic (Claude) : sans elle, le bouton « Analyser les pièces » est inactif.
ANTHROPIC_API_KEY=sk-ant-...
# Compartiment Supabase Storage PRIVÉ des pièces (créé automatiquement s'il n'existe pas ;
# nécessite SUPABASE_SERVICE_ROLE_KEY ci-dessus).
DOCUMENTS_BUCKET=pieces-dossiers
# Fournisseur du stockage des pièces : « supabase » (défaut) ou « s3 » (AWS S3, MinIO, Ceph…)
# STOCKAGE_PIECES=s3
# S3_ENDPOINT=https://minio.banque.local   # à omettre pour AWS S3
# S3_REGION=eu-west-3
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=true                 # MinIO
# Voir docs/changer-de-base.md
