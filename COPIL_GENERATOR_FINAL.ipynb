   "source": [
    "# @title 🚀 GÉNÉRER LA PRÉSENTATION\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"🚀 PF Scoring - Générateur COPIL\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "try:\n",
    "    if os.path.exists(CSV_FILE):\n",
    "        # Load and process\n",
    "        items = load_csv_data(CSV_FILE)\n",
    "        stats = calculate_statistics(items)\n",
    "        \n",
    "        # Generate in same folder\n",
    "        output_file = os.path.join(DRIVE_FOLDER, \"COPIL_Presentation.pptx\")\n",
    "        create_presentation(stats, output_file)\n",
    "        \n",
    "        print(\"\\n\" + \"=\"*60)\n",
    "        print(\"✅ SUCCÈS!\")\n",
    "        print(f\"📁 Fichier généré: COPIL_Presentation.pptx\")\n",
    "        print(f\"📍 Location: {DRIVE_FOLDER}\")\n",
    "        print(\"\\n💡 Vérifiez votre dossier Google Drive!\")\n",
    "        print(\"=\"*60)\n",
    "    else:\n",
    "        print(f\"\\n❌ Fichier non trouvé: {CSV_FILE}\")\n",
    "        print(\"\\n💡 Vérifiez que:\")\n",
    "        print(f\"   1. Le CSV existe dans: {DRIVE_FOLDER}\")\n",
    "        print(\"   2. Le chemin DRIVE_FOLDER est correct\")\nexcept Exception as e:\n",
    "    print(f\"\\n❌ Erreur: {str(e)}\")\n",
    "    print(\"\\n💡 Assurez-vous que le dossier est accessible\")"
   ]
  }
